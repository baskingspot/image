// One line per format with oracles: FORMAT(name) for name_ops in name.c,
// then what its oracles link, which `just oracle-build` reads from this
// comment: pkg-config packages (libpng, spng, libjpeg, libwebp, libtiff-4,
// libjxl, MagickWand) or -l flags (-lgif), and `-` for none.
FORMAT(png) // link: libpng spng
FORMAT(jpeg) // link: libjpeg
FORMAT(qoi) // link: -
FORMAT(qoi_encode) // link: -
FORMAT(bmp) // link: MagickWand
FORMAT(ico) // link: -
FORMAT(tga) // link: MagickWand
FORMAT(netpbm) // link: MagickWand
FORMAT(gif) // link: -lgif
FORMAT(wbmp) // link: MagickWand
FORMAT(webp) // link: libwebp
