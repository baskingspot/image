+//! LZ77 for the JPEG XL encoder's token streams (ISO/IEC 18181-1, the
+//! entropy coding annex): copies of a stream's earlier values, at the
+//! specification's special distances (the pixel above, the one to the
+//! left, and the rest of a small neighbourhood, by the stream's widest
+//! channel) or at any distance a hash of the next values finds, wherever a
+//! copy costs less than the literals it replaces.
+//!
+//! The decoder's window holds the values, the integers before their
+//! tokens, so a copy repeats residuals: a run of zeros, or a row whose
+//! residuals repeat the row above's. Costs come from the literals'
+//! histograms, before any copy; a copy's own cost is estimated.
+
+const std = @import("std");
+const testing = std.testing;
+
+const ent = @import("encode_entropy.zig");
+const Token = ent.Token;
+const Config = ent.Config;
+const Bump = @import("encode_mem.zig").Bump;
+
+pub const Options = struct {
+    /// The special distances tried at every position: the first this
+    /// many of the specification's 120, nearest first.
+    specials: u8,
+    /// Whether a hash of the next four values finds copies at any
+    /// distance.
+    hash: bool,
+};
+
+const hash_bits = 15;
+/// A hashed copy is measured up to this long; the special distances
+/// remember how far theirs reach.
+const max_hashed_len = 1 << 12;
+const none = std.math.maxInt(u32);
+
+/// The specification's special distances: (dx, dy), a copy from dx
+/// values back and dy rows of the stream's width up.
+const special_distances = [120][2]i8{
+    .{ 0, 1 },  .{ 1, 0 },  .{ 1, 1 },  .{ -1, 1 }, .{ 0, 2 },  .{ 2, 0 },  .{ 1, 2 },  .{ -1, 2 },
+    .{ 2, 1 },  .{ -2, 1 }, .{ 2, 2 },  .{ -2, 2 }, .{ 0, 3 },  .{ 3, 0 },  .{ 1, 3 },  .{ -1, 3 },
+    .{ 3, 1 },  .{ -3, 1 }, .{ 2, 3 },  .{ -2, 3 }, .{ 3, 2 },  .{ -3, 2 }, .{ 0, 4 },  .{ 4, 0 },
+    .{ 1, 4 },  .{ -1, 4 }, .{ 4, 1 },  .{ -4, 1 }, .{ 3, 3 },  .{ -3, 3 }, .{ 2, 4 },  .{ -2, 4 },
+    .{ 4, 2 },  .{ -4, 2 }, .{ 0, 5 },  .{ 3, 4 },  .{ -3, 4 }, .{ 4, 3 },  .{ -4, 3 }, .{ 5, 0 },
+    .{ 1, 5 },  .{ -1, 5 }, .{ 5, 1 },  .{ -5, 1 }, .{ 2, 5 },  .{ -2, 5 }, .{ 5, 2 },  .{ -5, 2 },
+    .{ 4, 4 },  .{ -4, 4 }, .{ 3, 5 },  .{ -3, 5 }, .{ 5, 3 },  .{ -5, 3 }, .{ 0, 6 },  .{ 6, 0 },
+    .{ 1, 6 },  .{ -1, 6 }, .{ 6, 1 },  .{ -6, 1 }, .{ 2, 6 },  .{ -2, 6 }, .{ 6, 2 },  .{ -6, 2 },
+    .{ 4, 5 },  .{ -4, 5 }, .{ 5, 4 },  .{ -5, 4 }, .{ 3, 6 },  .{ -3, 6 }, .{ 6, 3 },  .{ -6, 3 },
+    .{ 0, 7 },  .{ 7, 0 },  .{ 1, 7 },  .{ -1, 7 }, .{ 5, 5 },  .{ -5, 5 }, .{ 7, 1 },  .{ -7, 1 },
+    .{ 4, 6 },  .{ -4, 6 }, .{ 6, 4 },  .{ -6, 4 }, .{ 2, 7 },  .{ -2, 7 }, .{ 7, 2 },  .{ -7, 2 },
+    .{ 3, 7 },  .{ -3, 7 }, .{ 7, 3 },  .{ -7, 3 }, .{ 5, 6 },  .{ -5, 6 }, .{ 6, 5 },  .{ -6, 5 },
+    .{ 8, 0 },  .{ 4, 7 },  .{ -4, 7 }, .{ 7, 4 },  .{ -7, 4 }, .{ 8, 1 },  .{ 8, 2 },  .{ 6, 6 },
+    .{ -6, 6 }, .{ 8, 3 },  .{ 5, 7 },  .{ -5, 7 }, .{ 7, 5 },  .{ -7, 5 }, .{ 8, 4 },  .{ 6, 7 },
+    .{ -6, 7 }, .{ 7, 6 },  .{ -7, 6 }, .{ 8, 5 },  .{ 7, 7 },  .{ -7, 7 }, .{ 8, 6 },  .{ 8, 7 },
+};
+
+/// What a symbol costs, in sixteenths of a bit, per context: its share of
+/// its context's histogram, and its extra bits. From the literals'
+/// histograms a copy's cost is estimated; from histograms with copies
+/// (`dist_ctx` set), it is looked up.
+pub const Costs = struct {
+    bits: []u16,
+    config: Config,
+    /// The first length symbol.
+    min_symbol: u32,
+    dist_ctx: ?u32 = null,
+
+    pub fn memory(num_contexts: usize) usize {
+        return num_contexts * ent.alphabet * 2 + 64;
+    }
+
+    pub fn init(mem: *Bump, h: *const ent.Histograms, config: Config, min_symbol: u32, dist_ctx: ?u32) !Costs {
+        const bits = try mem.alloc(u16, h.num_contexts * ent.alphabet);
+        for (0..h.num_contexts) |ctx| {
+            const counts = h.of(ctx);
+            var total: u64 = 0;
+            for (counts) |k| total += k;
+            const lt = if (total == 0) 0 else std.math.log2(@as(f64, @floatFromInt(total)));
+            for (counts, bits[ctx * ent.alphabet ..][0..ent.alphabet]) |k, *b| {
+                // A symbol not seen would cost at least what the rarest
+                // costs; 24 bits stands for that.
+                const v: f64 = if (k == 0) 24 else lt - std.math.log2(@as(f64, @floatFromInt(k)));
+                b.* = @intFromFloat(@min(v, 24) * 16);
+            }
+        }
+        return .{ .bits = bits, .config = config, .min_symbol = min_symbol, .dist_ctx = dist_ctx };
+    }
+
+    inline fn literal(c: *const Costs, t: Token) u32 {
+        const s = c.config.split(t.value);
+        return @as(u32, c.bits[t.ctx * ent.alphabet + s.token]) + 16 * @as(u32, s.nbits);
+    }
+
+    /// A copy's cost in context `ctx`: its length and distance symbols
+    /// and their extra bits.
+    inline fn copy(c: *const Costs, ctx: u32, len: usize, code: u32) u32 {
+        const ls = ent.lz_len_config.split(@intCast(len - ent.lz_min_length));
+        const ds = c.config.split(code);
+        const extra = 16 * (@as(u32, ls.nbits) + @as(u32, ds.nbits));
+        if (c.dist_ctx) |dc| {
+            return extra + c.bits[ctx * ent.alphabet + c.min_symbol + ls.token] +
+                c.bits[dc * ent.alphabet + ds.token];
+        }
+        // Estimates, before the copies' symbols have histograms.
+        const dist_bits: u32 = if (code < 8) 3 else if (code < 120) 6 else 9;
+        return extra + 16 * (5 + dist_bits);
+    }
+};
+
+/// The memory `apply` takes for a stream of up to `n` tokens.
+pub fn memory(n: usize) usize {
+    return (2 * n + 1) * 4 + (@as(usize, 1) << hash_bits) * 4 + 3 * 64;
+}
+
+/// Rewrites `tokens`, a stream's literals, in place with copies wherever
+/// they save bits; returns how many tokens remain. `width` is the
+/// stream's distance multiplier (its widest channel), as the decoder
+/// computes it, and `dist_ctx` the context distances are coded in.
+pub fn apply(
+    mem: *Bump,
+    tokens: []Token,
+    width: u32,
+    dist_ctx: u32,
+    costs: *const Costs,
+    options: Options,
+) error{WorkTooSmall}!usize {
+    const n = tokens.len;
+    if (n <= ent.lz_min_length) return n;
+    const m = mem.mark();
+    defer mem.release(m);
+    const values = try mem.alloc(u32, n);
+    for (values, tokens) |*v, t| v.* = t.value;
+    // cum[i]: what the literals before i cost.
+    const cum = try mem.alloc(u32, n + 1);
+    cum[0] = 0;
+    for (tokens, 0..) |t, i| cum[i + 1] = cum[i] + costs.literal(t);
+    const heads: []u32 = if (options.hash) try mem.alloc(u32, @as(usize, 1) << hash_bits) else &.{};
+    @memset(heads, none);
+
+    // The special distances' offsets back, and how far a copy at each
+    // reaches from where it was last measured.
+    const ns: usize = @min(options.specials, special_distances.len);
+    var offs: [special_distances.len]u32 = undefined;
+    var ends: [special_distances.len]usize = @splat(0);
+    for (special_distances, &offs) |sd, *o| {
+        const d = @as(i64, sd[0]) + @as(i64, width) * sd[1];
+        o.* = @intCast(std.math.clamp(d, 1, ent.lz_window));
+    }
+
+    var out: usize = 0;
+    var i: usize = 0;
+    while (i < n) {
+        var best_gain: i64 = 0;
+        var best_len: usize = 0;
+        var best_code: u32 = 0;
+        for (offs[0..ns], ends[0..ns], 0..) |d, *end, k| {
+            if (d > i) continue;
+            if (end.* <= i) end.* = i + matchLen(values, i, d, n - i);
+            const len = end.* - i;
+            if (len < ent.lz_min_length) continue;
+            const gain = @as(i64, cum[i + len] - cum[i]) - costs.copy(tokens[i].ctx, len, @intCast(k));
+            if (gain > best_gain) {
+                best_gain = gain;
+                best_len = len;
+                best_code = @intCast(k);
+            }
+        }
+        if (options.hash and i + 4 <= n) {
+            const h = hash(values[i..][0..4]);
+            const cand = heads[h];
+            heads[h] = @intCast(i);
+            if (cand != none and i - cand <= ent.lz_window) {
+                const d: u32 = @intCast(i - cand);
+                const code = codeOf(d, &offs);
+                // Measured only when it could beat the best so far, and
+                // not again at a special distance already measured.
+                const len = if (code < ns or i + best_len >= n or values[i + best_len] != values[i + best_len - d])
+                    0
+                else
+                    matchLen(values, i, d, @min(n - i, max_hashed_len));
+                if (len >= ent.lz_min_length) {
+                    const gain = @as(i64, cum[i + len] - cum[i]) - costs.copy(tokens[i].ctx, len, code);
+                    if (gain > best_gain) {
+                        best_gain = gain;
+                        best_len = len;
+                        best_code = code;
+                    }
+                }
+            }
+        }
+        if (best_len == 0) {
+            tokens[out] = tokens[i];
+            out += 1;
+            i += 1;
+            continue;
+        }
+        // A copy takes at least three positions and leaves two tokens,
+        // so writing never passes reading.
+        const ctx = tokens[i].ctx;
+        tokens[out] = .{ .ctx = ctx | ent.lz_length, .value = @intCast(best_len - ent.lz_min_length) };
+        tokens[out + 1] = .{ .ctx = dist_ctx, .value = best_code };
+        out += 2;
+        if (options.hash) {
+            var j = i + 1;
+            while (j < i + best_len and j + 4 <= n) : (j += 1) heads[hash(values[j..][0..4])] = @intCast(j);
+        }
+        i += best_len;
+    }
+    return out;
+}
+
+/// How many values from `i` repeat those `d` back, up to `max`.
+fn matchLen(values: []const u32, i: usize, d: u32, max: usize) usize {
+    var len: usize = 0;
+    while (len < max and values[i + len] == values[i + len - d]) len += 1;
+    return len;
+}
+
+/// The distance code for `d` values back: the first special distance
+/// that lands there, or the plain distance.
+fn codeOf(d: u32, offs: *const [special_distances.len]u32) u32 {
+    for (offs, 0..) |o, k| {
+        if (o == d) return @intCast(k);
+    }
+    return d + 119;
+}
+
+inline fn hash(v: *const [4]u32) usize {
+    var h: u64 = v[0];
+    h = h *% 0x9E3779B97F4A7C15 +% v[1];
+    h = h *% 0x9E3779B97F4A7C15 +% v[2];
+    h = h *% 0x9E3779B97F4A7C15 +% v[3];
+    return @intCast((h *% 0x9E3779B97F4A7C15) >> (64 - hash_bits));
+}
+
+test "copies round trip through the decoder" {
+    const entropy = @import("entropy.zig");
+    const BitReader = @import("BitReader.zig");
+    const Arena = @import("Arena.zig");
+    const BitWriter = @import("encode_bits.zig").BitWriter;
+    const gpa = testing.allocator;
+    const membuf = try gpa.alloc(u8, 16 << 20);
+    defer gpa.free(membuf);
+    var mem: Bump = .init(membuf);
+    // Rows of 37 with a run of zeros, a row repeating the one above, a
+    // pattern far back, and noise; two contexts.
+    const width = 37;
+    var prng: std.Random.DefaultPrng = .init(5);
+    const random = prng.random();
+    var lits: [width * 40]Token = undefined;
+    for (&lits, 0..) |*t, i| {
+        const y = i / width;
+        const x = i % width;
+        const v: u32 = switch (y % 5) {
+            0 => 0,
+            1 => @intCast(x * 3),
+            2 => lits[i - width].value,
+            3 => if (y > 10) lits[i - 10 * width].value else random.uintLessThan(u32, 50),
+            else => random.uintLessThan(u32, 1000),
+        };
+        t.* = .{ .ctx = @intCast(x & 1), .value = v };
+    }
+    var hist: ent.Histograms = try .init(&mem, 2);
+    hist.addTokens(&lits, .{});
+    const min_symbol = @max(8, hist.symbols());
+    const costs: Costs = try .init(&mem, &hist, .{}, min_symbol, null);
+    var tokens = lits;
+    const n = try apply(&mem, &tokens, width, 2, &costs, .{ .specials = 120, .hash = true });
+    try testing.expect(n < lits.len / 2);
+    var lz_hist: ent.Histograms = try .init(&mem, 3);
+    lz_hist.addTokensLz(tokens[0..n], .{}, min_symbol);
+    const code = try ent.Code.build(&mem, &lz_hist, .{ .lz77 = true, .lz_min_symbol = min_symbol });
+    const buf = try gpa.alloc(u8, 1 << 16);
+    defer gpa.free(buf);
+    var w: BitWriter = .init(buf);
+    // The decoder's source wants a codestream signature.
+    w.bits(0x0aff, 16);
+    try code.write(&w, &mem);
+    const scratch = try mem.alloc(u32, n);
+    code.encode(&w, tokens[0..n], scratch);
+    w.padToByte();
+    w.append(&@as([8]u8, @splat(0)));
+    try testing.expect(!w.overflow);
+
+    var r: std.Io.Reader = .fixed(w.bytes());
+    var br: BitReader = .init(&r, null);
+    _ = try br.bits(16);
+    const arena_buf = try gpa.alloc(u8, 8 << 20);
+    defer gpa.free(arena_buf);
+    var arena: Arena = .init(arena_buf);
+    // Two contexts; LZ77 adds the distances' third.
+    const dcode = try entropy.Code.read(&br, &arena, 2);
+    var rd = try entropy.Reader.init(&dcode, &br, &arena, width, lits.len);
+    for (lits) |t| try testing.expectEqual(t.value, try rd.read(&br, t.ctx));
+    try testing.expect(rd.finalOk());
+}
